<Window x:Class="PurviewFileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PurviewFileManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0"
           Grid.Column="0"
           Content="File Path:" />

            <TextBox x:Name="txtFilePath"
             Grid.Row="0"
             Grid.Column="1"
             Margin="5"/>

            <Button x:Name="btnBrowse" Click="btnBrowse_Click"
            Grid.Row="0"
            Grid.Column="2"
            Margin="5"
            Content="Browse"/>

            <Label Grid.Row="1"
           Grid.Column="0"
           Content="Labels:"/>

            <ComboBox x:Name="cmbLabels"
              Grid.Row="1"
              Grid.Column="1"
              Margin="5"/>

            <StackPanel Grid.Row="2"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                Margin="5">

                <Button x:Name="btnLoadLabels" Click="btnLoadLabels_Click" 
                Width="120"
                Margin="5"
                Content="Create Auth Delegate"/>

                <Button x:Name="btnReadFile" Click="btnReadFile_Click"
                Width="120"
                Margin="5"
                Content="Read File"/>

                <Button x:Name="btnApplyLabel" Click="btnApplyLabel_Click"
                Width="120"
                Margin="5"
                Content="Apply Label"/>

                <Button x:Name="btnRemoveLabel" Click="btnRemoveLabel_Click"
                Width="120"
                Margin="5"
                Content="Remove Label"/>
            </StackPanel>

            <TextBlock x:Name="txtStatus"
               Grid.Row="3"
               Grid.ColumnSpan="3"
               Margin="5"
               FontWeight="Bold"
               Text="Ready"/>

            <TextBox x:Name="txtContent"
             Grid.Row="4"
             Grid.ColumnSpan="3"
             Margin="5"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"/>

        </Grid>
    </Grid>
</Window>
